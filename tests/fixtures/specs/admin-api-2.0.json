{
  "swagger": "2.0",
  "info": {
    "title": "Admin API Legacy",
    "version": "1.2.0",
    "description": "Legacy administrative endpoints",
    "contact": { "name": "API Team" }
  },
  "host": "api.example.test",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json", "application/problem+json"],
  "tags": [{ "name": "users", "description": "User administration" }],
  "externalDocs": { "url": "https://docs.example.test" },
  "x-owner": "platform",
  "securityDefinitions": {
    "apiKey": { "type": "apiKey", "name": "X-API-Key", "in": "header" }
  },
  "security": [{ "apiKey": [] }],
  "definitions": {
    "User": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string", "minLength": 1 },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "CreateUser": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    }
  },
  "parameters": {
    "TraceId": { "name": "X-Trace-Id", "in": "header", "type": "string", "description": "Request trace" }
  },
  "responses": {
    "Problem": {
      "description": "Problem response",
      "headers": { "X-Trace-Id": { "type": "string" } },
      "schema": { "type": "object", "additionalProperties": true }
    }
  },
  "paths": {
    "/users/{userId}": {
      "parameters": [{ "name": "userId", "in": "path", "required": true, "type": "integer", "format": "int64" }],
      "get": {
        "operationId": "getLegacyUser",
        "summary": "Get a legacy user",
        "tags": ["users"],
        "parameters": [{ "$ref": "#/parameters/TraceId" }],
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "User found", "schema": { "$ref": "#/definitions/User" }, "examples": { "application/json": { "id": 7, "name": "Admin" } } },
          "404": { "$ref": "#/responses/Problem" }
        }
      },
      "put": {
        "operationId": "replaceLegacyUser",
        "tags": ["users"],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "description": "Replacement", "schema": { "$ref": "#/definitions/CreateUser" } }
        ],
        "responses": {
          "200": { "description": "Updated", "schema": { "$ref": "#/definitions/User" } },
          "default": { "$ref": "#/responses/Problem" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "legacyHealth",
        "security": [],
        "responses": { "204": { "description": "Healthy" } }
      }
    }
  }
}
