{
  "name": "zopia",
  "version": "0.3.0",
  "description": "Type-safe OpenAPI, JSON Schema, and Zod conversion toolkit.",
  "keywords": [
    "api-docs",
    "json-schema",
    "km-api",
    "openapi",
    "swagger",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/komeilm76/zopia#readme",
  "bugs": {
    "url": "https://github.com/komeilm76/zopia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komeilm76/zopia.git"
  },
  "author": "komeilm76",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "bin",
    "src",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "bun@1.2.21",
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "km-api": "^0.4.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.11",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "km-api": "^0.4.1",
    "zod": "^4.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && bun scripts/check-coverage.ts",
    "package:check": "bun scripts/package-check.ts",
    "release:check": "bun run bun:gate",
    "prepublishOnly": "bun run release:check",
    "bun:gate": "bun scripts/bun-gate.ts",
    "golden:update": "bun scripts/update-golden.ts",
    "build": "tsc --noEmit"
  },
  "bin": {
    "zopia": "./bin/zopia.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
