{
  "name": "zopia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Type-safe OpenAPI, JSON Schema, and Zod conversion toolkit.",
  "license": "MIT",
  "packageManager": "bun@1.2.21",
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^2.1.9",
    "km-api": "^0.4.1",
    "typescript": "^5.9.2",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "km-api": "^0.4.1",
    "zod": "^4.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && vite-node scripts/check-coverage.ts",
    "bun:gate": "bun scripts/bun-gate.ts",
    "golden:update": "vite-node scripts/update-golden.ts",
    "build": "tsc --noEmit"
  },
  "bin": {
    "zopia": "./bin/zopia.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
